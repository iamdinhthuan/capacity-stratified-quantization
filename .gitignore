exports/
# TensorRT SDK tar extraction
third_party/
weights/
*.pt
*.onnx
*.plan
*.engine

# --- large intermediate predictions (regenerable from weights + tools/infer.py) ---
metrics/pred_*.json

# --- secrets: never commit any credential ---
*.token
*token*
.env
.netrc

# --- local tooling / scratch ---
.claude/
__pycache__/
*.pyc
runs_*.log
*.tmp
.DS_Store

